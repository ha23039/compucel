<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CompuCel" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondaryContainer">@color/primary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_primary_container</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline_strong</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorError">@color/error_texto_campo</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">@bool/barras_claras</item>
        <item name="android:windowLightNavigationBar">@bool/barras_claras</item>

        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.CompuCel.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CompuCel.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CompuCel.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CompuCel.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CompuCel.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CompuCel.LabelLarge</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.CompuCel.LabelSmall</item>

        <item name="shapeAppearanceCornerSmall">@style/Forma.CompuCel.Pequena</item>
        <item name="shapeAppearanceCornerMedium">@style/Forma.CompuCel.Mediana</item>
        <item name="shapeAppearanceCornerLarge">@style/Forma.CompuCel.Grande</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/Forma.CompuCel.ExtraGrande</item>

        <item name="materialButtonStyle">@style/Widget.CompuCel.Boton</item>
        <item name="textInputStyle">@style/Widget.CompuCel.Campo</item>
        <item name="materialCardViewStyle">@style/Widget.CompuCel.Tarjeta</item>
    </style>

    <!-- Tema de arranque: solo el color de fondo, para que el unico logo visible sea el de SplashActivity -->
    <style name="Theme.CompuCel.Splash">
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.CompuCel.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">32sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.CompuCel.Stat" parent="TextAppearance.CompuCel.Headline">
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">32sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.CompuCel.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.CompuCel.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.CompuCel.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.CompuCel.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.CompuCel.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.CompuCel.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <!-- Etiquetas de seccion en mayusculas (HOY, ACCESO RAPIDO, GESTION) -->
    <style name="TextAppearance.CompuCel.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/on_surface_subtle</item>
    </style>

    <style name="Forma.CompuCel.Pequena" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>
    <style name="Forma.CompuCel.Mediana" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_md</item>
    </style>
    <style name="Forma.CompuCel.Grande" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_lg</item>
    </style>
    <style name="Forma.CompuCel.ExtraGrande" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_xl</item>
    </style>

    <style name="Widget.CompuCel.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="shapeAppearance">@style/Forma.CompuCel.Mediana</item>
        <item name="android:textAppearance">@style/TextAppearance.CompuCel.LabelLarge</item>
    </style>
    <style name="Widget.CompuCel.Boton.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="shapeAppearance">@style/Forma.CompuCel.Mediana</item>
        <item name="android:textAppearance">@style/TextAppearance.CompuCel.LabelLarge</item>
        <item name="strokeColor">@color/outline_strong</item>
    </style>
    <style name="Widget.CompuCel.Boton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="shapeAppearance">@style/Forma.CompuCel.Mediana</item>
        <item name="android:textAppearance">@style/TextAppearance.CompuCel.LabelLarge</item>
    </style>
    <style name="Widget.CompuCel.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.CompuCel.LabelLarge</item>
    </style>
    <style name="Widget.CompuCel.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxBackgroundMode">outline</item>
    </style>
    <style name="Widget.CompuCel.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/Forma.CompuCel.Grande</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
