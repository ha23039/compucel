<?xml version="1.0" encoding="utf-8"?>
<!-- Contenedor principal: barra superior, contenido por pestana y barra de navegacion -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        app:title="@string/app_name"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge"
        app:titleTextColor="@color/on_surface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <FrameLayout
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navegacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@style/Widget.CompuCel.Navegacion.Indicador"
        app:itemIconTint="@color/nav_icono"
        app:itemTextAppearanceActive="@style/TextAppearance.CompuCel.LabelSmall"
        app:itemTextAppearanceInactive="@style/TextAppearance.CompuCel.LabelSmall"
        app:itemTextColor="@color/nav_texto"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_navegacion" />
</LinearLayout>
