<?xml version="1.0" encoding="utf-8"?>
<!-- CTA-02 Estado de sincronizacion -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/sincronizacion"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge"
        app:titleTextColor="@color/on_surface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <LinearLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_banner_advertencia"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3">

                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cloud_upload" />

                <TextView
                    android:id="@+id/tvBanner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/advertencia_texto" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/seccion_pendientes_modulo"
                android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <include
                        android:id="@+id/filaPerfil"
                        layout="@layout/fila_dato" />

                    <include
                        android:id="@+id/filaClientes"
                        layout="@layout/fila_dato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3" />
                    <include
                        android:id="@+id/filaServicios"
                        layout="@layout/fila_dato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/seccionErrores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/seccion_errores"
                    android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2">

                    <LinearLayout
                        android:id="@+id/listaErrores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_4"
                        android:paddingTop="@dimen/space_2"
                        android:paddingEnd="@dimen/space_2"
                        android:paddingBottom="@dimen/space_2" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btSincronizar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_boton"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/sincronizar_ahora"
                app:icon="@drawable/ic_sync"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/on_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
