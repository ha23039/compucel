<?xml version="1.0" encoding="utf-8"?>
<!-- CTA-01 Perfil: datos del usuario, cambio de nombre y contrasena, apariencia y sincronizacion -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/perfil"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge"
        app:titleTextColor="@color/on_surface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAvatar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/fondo_avatar"
                            android:gravity="center"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/on_primary_container" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="@color/on_surface" />

                            <TextView
                                android:id="@+id/tvEstadoPerfil"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/fondo_badge_neutro"
                                android:paddingStart="10dp"
                                android:paddingTop="@dimen/space_1"
                                android:paddingEnd="10dp"
                                android:paddingBottom="@dimen/space_1"
                                android:text="@string/perfil_sincronizado"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="@color/neutro_texto" />
                        </LinearLayout>
                    </LinearLayout>

                    <include
                        android:id="@+id/filaCorreo"
                        layout="@layout/fila_dato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/seccion_cuenta"
                android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/filaCambiarNombre"
                        layout="@layout/fila_menu" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline" />

                    <include
                        android:id="@+id/filaCambiarClave"
                        layout="@layout/fila_menu" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/seccion_apariencia"
                android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoTema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btTemaClaro"
                    style="@style/Widget.CompuCel.Segmento"
                    android:text="@string/tema_claro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btTemaOscuro"
                    style="@style/Widget.CompuCel.Segmento"
                    android:text="@string/tema_oscuro" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btTemaSistema"
                    style="@style/Widget.CompuCel.Segmento"
                    android:text="@string/tema_sistema" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/seccion_sincronizacion"
                android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <include
                        android:id="@+id/filaUltimaSync"
                        layout="@layout/fila_dato" />

                    <include
                        android:id="@+id/filaPendientes"
                        layout="@layout/fila_dato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3" />

                    <include
                        android:id="@+id/filaVersion"
                        layout="@layout/fila_dato"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btSincronizar"
                        style="@style/Widget.CompuCel.Boton.Tonal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/alto_boton"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/sincronizar_ahora"
                        app:icon="@drawable/ic_sync"
                        app:iconGravity="textStart"
                        app:iconSize="20dp"
                        app:iconTint="@color/on_primary_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btCerrarSesion"
                style="@style/Widget.CompuCel.Boton.Contorno"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_boton"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/cerrar_sesion"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
