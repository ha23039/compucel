<?xml version="1.0" encoding="utf-8"?>
<!-- CLI-01 Lista de clientes con busqueda, filtros y estado vacio -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingEnd="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/fondo_busqueda"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_2">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/edtBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/buscar_clientes"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/on_surface"
                android:textColorHint="@color/on_surface_subtle" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            app:chipSpacingHorizontal="@dimen/space_2"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActivos"
                style="@style/Widget.CompuCel.Chip.Filtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/filtro_activos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInactivos"
                style="@style/Widget.CompuCel.Chip.Filtro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filtro_inactivos" />
        </com.google.android.material.chip.ChipGroup>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/space_3">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvClientes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp" />

            <LinearLayout
                android:id="@+id/estadoVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_6"
                android:paddingTop="@dimen/space_12"
                android:paddingEnd="@dimen/space_6"
                android:paddingBottom="@dimen/space_12"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivVacio"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search_grande" />

                <TextView
                    android:id="@+id/tvVacioTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tvVacioDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/on_surface_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btLimpiarBusqueda"
                    style="@style/Widget.CompuCel.Boton.Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/alto_boton"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/limpiar_busqueda" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        style="@style/Widget.CompuCel.Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_4"
        android:contentDescription="@string/agregar_cliente"
        app:srcCompat="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
