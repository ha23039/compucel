<?xml version="1.0" encoding="utf-8"?>
<!-- INI-01 Inicio: resumen de clientes, accesos rapidos y lo que requiere atencion -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/space_4"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:id="@+id/bannerSinConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            android:background="@drawable/fondo_banner_neutro"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_3"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cloud_off"
                app:tint="@color/neutro_texto" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:text="@string/sin_conexion"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/neutro_texto" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/inicio_subtitulo"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/seccion_hoy"
            android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActivos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_activos"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface_subtle" />

                    <TextView
                        android:id="@+id/tvActivos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.CompuCel.Stat"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInactivos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_inactivos"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface_subtle" />

                    <TextView
                        android:id="@+id/tvInactivos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.CompuCel.Stat"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_total"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface_subtle" />

                    <TextView
                        android:id="@+id/tvTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.CompuCel.Stat"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendientes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_pendientes"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface_subtle" />

                    <TextView
                        android:id="@+id/tvPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.CompuCel.Stat"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/seccion_acceso_rapido"
            android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoNuevoCliente"
                style="@style/Widget.CompuCel.Tarjeta.Acceso">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_3">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person_add" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/acceso_nuevo_cliente"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoClientes"
                style="@style/Widget.CompuCel.Tarjeta.Acceso"
                android:layout_marginStart="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_3">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_people"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/acceso_clientes"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoUbicacion"
                style="@style/Widget.CompuCel.Tarjeta.Acceso"
                android:layout_marginStart="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_3">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location_on" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/acceso_ubicacion"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoSincronizar"
                style="@style/Widget.CompuCel.Tarjeta.Acceso">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_3">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sync" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/acceso_sincronizar"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/accesoPerfil"
                style="@style/Widget.CompuCel.Tarjeta.Acceso"
                android:layout_marginStart="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_2"
                    android:paddingTop="@dimen/space_3"
                    android:paddingEnd="@dimen/space_2"
                    android:paddingBottom="@dimen/space_3">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/acceso_perfil"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/seccion_atencion"
            android:textAppearance="@style/TextAppearance.CompuCel.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAtencion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_3">

                <ImageView
                    android:id="@+id/ivAtencion"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cloud_done" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAtencionTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/atencion_al_dia"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/on_surface" />

                    <TextView
                        android:id="@+id/tvAtencionDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/atencion_al_dia_detalle"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/on_surface_subtle" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
