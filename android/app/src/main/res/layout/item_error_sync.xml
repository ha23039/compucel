<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de ERRORES de CTA-02 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_2">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_warning" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvErrorTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/error_envio_detalle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_variant" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btReintentar"
        style="@style/Widget.CompuCel.Boton.Texto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reintentar" />
</LinearLayout>
