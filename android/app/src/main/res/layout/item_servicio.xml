<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvServicioNombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/on_surface" />
            <ImageView
                android:id="@+id/ivServicioPendiente"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/cliente_pendiente"
                android:src="@drawable/ic_cloud_upload"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServicioDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/on_surface_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvServicioCosto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/on_surface" />
            <TextView
                android:id="@+id/tvServicioTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="end"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btServicioEditar"
                style="@style/Widget.CompuCel.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/editar" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btServicioEliminar"
                style="@style/Widget.CompuCel.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eliminar" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>